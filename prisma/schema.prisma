// Talentis Connect — Prisma schema
// See /root/.claude/plans/root-claude-uploads-e0a0d049-a0b6-5d86-linear-lecun.md for design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Phase A: identity & accounts ----------

enum Role {
  CLIENT
  CABINET
  CANDIDATE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clientProfile   ClientProfile?
  cabinetProfile  CabinetProfile?
  candidate       Candidate?

  sentInvites          CabinetInvite[]     @relation("InvitedBy")
  createdMandats       Mandat[]            @relation("MandatCreatedBy")
  mandatMessages       MandatMessage[]
  mandatStatusEvents   MandatStatusEvent[]
  addedApplications    MandateApplication[] @relation("ApplicationAddedBy")
  proposedSlots        InterviewSlot[]
  submittedFeedback    Interview[]         @relation("FeedbackBy")
  postedJobs           JobPosting[]
  createdCourses       TrainingCourse[]
  confirmedEnrollments Enrollment[]        @relation("EnrollmentConfirmedBy")
  enrollments          Enrollment[]        @relation("EnrollmentUser")
  notifications        Notification[]
  jobAlerts            JobAlert[]
  directMessages       DirectMessage[]
  requestedSponsorships JobSponsorship[]   @relation("SponsorshipRequestedBy")
  confirmedSponsorships JobSponsorship[]   @relation("SponsorshipConfirmedBy")
  createdCandidates    Candidate[]         @relation("CandidateCreatedBy")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  requestedCvAccess    CvDatabaseAccess[]  @relation("CvAccessRequestedBy")
  confirmedCvAccess    CvDatabaseAccess[]  @relation("CvAccessConfirmedBy")
  companyReviews       CompanyReview[]

  @@map("users")
}

model Company {
  id         String    @id @default(cuid())
  name       String
  ice        String?
  sector     String?
  city       String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  clientProfiles    ClientProfile[]
  mandats           Mandat[]
  jobPostings       JobPosting[]
  cvDatabaseAccess  CvDatabaseAccess[]
  reviews           CompanyReview[]

  @@map("companies")
}

model ClientProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  companyId String
  jobTitle  String?
  phone     String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model CabinetProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  isAdmin         Boolean  @default(false)
  title           String?
  phone           String?
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String[] @default([])

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedMandats  Mandat[]           @relation("AssignedConsultant")

  @@map("cabinet_profiles")
}

model CabinetInvite {
  id             String    @id @default(cuid())
  email          String
  token          String    @unique
  invitedByUserId String
  isAdmin        Boolean   @default(false)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  invitedBy User @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@map("cabinet_invites")
}

enum CandidateSource {
  INTERNAL_DB
  JOBBOARD
  NETWORK
  COOPTATION
  SELF_REGISTERED
}

model Candidate {
  id              String          @id @default(cuid())
  userId          String?         @unique
  firstName       String
  lastName        String
  email           String
  phone           String?
  headline        String?
  location        String?
  yearsExperience Int?
  skills          String[]        @default([])
  cvUrl           String?
  source          CandidateSource @default(SELF_REGISTERED)
  createdByUserId String?
  createdAt       DateTime        @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdBy     User?    @relation("CandidateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  applications    MandateApplication[]
  jobApplications JobApplication[]
  enrollments     Enrollment[]
  interviews      Interview[]

  @@map("candidates")
}

// ---------- Phase B: mandates ----------

enum MandatStatus {
  NEW
  SOURCING
  SHORTLIST_SENT
  CLIENT_SELECTING
  INTERVIEWING
  OFFER
  WON
  CANCELLED
}

enum MandatUrgency {
  LOW
  MEDIUM
  HIGH
}

enum MandatCloseReason {
  WON
  CANCELLED
}

model Mandat {
  id               String            @id @default(cuid())
  reference        String            @unique
  companyId        String
  createdByUserId  String
  title            String
  skillsRequired   String[]          @default([])
  experienceLevel  String?
  salaryMin         Int?
  salaryMax         Int?
  currency         String            @default("MAD")
  location         String?
  remotePolicy     String?
  urgency          MandatUrgency     @default(MEDIUM)
  status           MandatStatus      @default(NEW)
  assignedConsultantId String?
  wonCandidateId   String?
  closedAt         DateTime?
  closeReason      MandatCloseReason?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy          User                @relation("MandatCreatedBy", fields: [createdByUserId], references: [id])
  assignedConsultant CabinetProfile?     @relation("AssignedConsultant", fields: [assignedConsultantId], references: [id])

  messages     MandatMessage[]
  applications MandateApplication[]
  interviews   Interview[]
  events       MandatStatusEvent[]
  jobPostings  JobPosting[]

  @@map("mandats")
}

model MandatStatusEvent {
  id          String        @id @default(cuid())
  mandatId    String
  fromStatus  MandatStatus?
  toStatus    MandatStatus
  actorUserId String
  note        String?
  createdAt   DateTime      @default(now())

  mandat Mandat @relation(fields: [mandatId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorUserId], references: [id])

  @@map("mandat_status_events")
}

model MandatMessage {
  id           String   @id @default(cuid())
  mandatId     String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())

  mandat Mandat @relation(fields: [mandatId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorUserId], references: [id])

  @@map("mandat_messages")
}

// ---------- Phase C: shortlist ----------

enum MandateApplicationStatus {
  PROPOSED
  PUBLISHED_TO_CLIENT
  SELECTED_BY_CLIENT
  REJECTED_BY_CLIENT
  INTERVIEWING
  VALIDATED
  RESERVED
  REFUSED
  HIRED
}

model MandateApplication {
  id            String                    @id @default(cuid())
  mandatId      String
  candidateId   String
  addedByUserId String
  prequalNotes  String?
  strengths     String?
  watchPoints   String?
  status        MandateApplicationStatus  @default(PROPOSED)
  publishedAt   DateTime?
  selectedAt    DateTime?
  createdAt     DateTime                  @default(now())

  mandat    Mandat    @relation(fields: [mandatId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  addedBy   User      @relation("ApplicationAddedBy", fields: [addedByUserId], references: [id])

  interviews Interview[]

  @@unique([mandatId, candidateId])
  @@map("mandate_applications")
}

// ---------- Phase D: interviews ----------

enum InterviewMode {
  ONSITE
  VIDEO
  PHONE
}

enum InterviewStatus {
  SLOT_PROPOSED
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewFeedbackOutcome {
  VALIDATED
  RESERVED
  REFUSED
}

model Interview {
  id                    String                     @id @default(cuid())
  mandatId              String
  mandateApplicationId  String
  candidateId           String
  scheduledAt           DateTime?
  durationMinutes       Int?
  mode                  InterviewMode?
  meetingLink           String?
  status                InterviewStatus            @default(SLOT_PROPOSED)
  clientFeedbackOutcome InterviewFeedbackOutcome?
  clientFeedbackComment String?
  feedbackSubmittedAt   DateTime?
  feedbackByUserId      String?
  createdAt             DateTime                   @default(now())

  mandat              Mandat              @relation(fields: [mandatId], references: [id], onDelete: Cascade)
  mandateApplication  MandateApplication  @relation(fields: [mandateApplicationId], references: [id], onDelete: Cascade)
  candidate           Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  feedbackBy          User?               @relation("FeedbackBy", fields: [feedbackByUserId], references: [id])

  slots InterviewSlot[]

  @@map("interviews")
}

model InterviewSlot {
  id             String   @id @default(cuid())
  interviewId    String
  proposedByUserId String
  startAt        DateTime
  endAt          DateTime
  chosen         Boolean  @default(false)
  createdAt      DateTime @default(now())

  interview  Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  proposedBy User      @relation(fields: [proposedByUserId], references: [id])

  @@map("interview_slots")
}

// ---------- Phase F: public job board ----------

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model JobPosting {
  id            String           @id @default(cuid())
  companyId     String
  mandatId      String?
  postedByUserId String
  title         String
  description   String
  missions      String[]         @default([])
  profile       String[]         @default([])
  city          String?
  remoteType    String?
  contractType  String?
  category      String?
  salaryMin      Int?
  salaryMax      Int?
  status        JobPostingStatus @default(DRAFT)
  publishedAt   DateTime?
  sponsoredUntil DateTime?
  viewCount     Int              @default(0)
  createdAt     DateTime         @default(now())

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mandat   Mandat? @relation(fields: [mandatId], references: [id], onDelete: SetNull)
  postedBy User    @relation(fields: [postedByUserId], references: [id])

  applications  JobApplication[]
  sponsorships  JobSponsorship[]

  @@map("job_postings")
}

enum JobApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  HIRED
}

model JobApplication {
  id                              String                @id @default(cuid())
  jobPostingId                    String
  candidateId                     String
  coverNote                       String?
  cvUrl                           String?
  status                          JobApplicationStatus  @default(SUBMITTED)
  promotedToMandateApplicationId  String?
  createdAt                       DateTime              @default(now())

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  candidate  Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  messages   DirectMessage[]

  @@unique([jobPostingId, candidateId])
  @@map("job_applications")
}

/** Direct chat between the recruiter (Client) and the candidate on one public job application. */
model DirectMessage {
  id               String   @id @default(cuid())
  jobApplicationId String
  senderUserId     String
  body             String
  createdAt        DateTime @default(now())

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  sender         User           @relation(fields: [senderUserId], references: [id])

  @@map("direct_messages")
}

enum SponsorshipPaymentMethod {
  VIREMENT
  ESPECES
  AUTRE
}

enum SponsorshipPaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/** Paid boost requested by a Client on their own JobPosting — manual payment confirmation, same pattern as Enrollment. */
model JobSponsorship {
  id                String                   @id @default(cuid())
  jobPostingId      String
  requestedByUserId String
  durationDays      Int
  price             Int
  currency          String                   @default("MAD")
  paymentMethod     SponsorshipPaymentMethod
  paymentStatus     SponsorshipPaymentStatus @default(PENDING)
  startAt           DateTime?
  endAt             DateTime?
  createdAt         DateTime                 @default(now())
  confirmedAt       DateTime?
  confirmedByUserId String?

  jobPosting  JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("SponsorshipRequestedBy", fields: [requestedByUserId], references: [id])
  confirmedBy User?      @relation("SponsorshipConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@map("job_sponsorships")
}

enum CvAccessPaymentMethod {
  VIREMENT
  ESPECES
  AUTRE
}

enum CvAccessPaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/** Paid access to the candidate database (CVthèque) for a Client's whole company — manual payment confirmation, same pattern as JobSponsorship/Enrollment. */
model CvDatabaseAccess {
  id                String                 @id @default(cuid())
  companyId         String
  requestedByUserId String
  durationDays      Int
  price             Int
  currency          String                 @default("MAD")
  paymentMethod     CvAccessPaymentMethod
  paymentStatus     CvAccessPaymentStatus  @default(PENDING)
  startAt           DateTime?
  endAt             DateTime?
  createdAt         DateTime               @default(now())
  confirmedAt       DateTime?
  confirmedByUserId String?

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("CvAccessRequestedBy", fields: [requestedByUserId], references: [id])
  confirmedBy User?   @relation("CvAccessConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@map("cv_database_access")
}

enum CompanyReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/** Candidate-authored rating of a Company, moderated by the Cabinet before it appears publicly. */
model CompanyReview {
  id          String              @id @default(cuid())
  companyId   String
  authorUserId String
  rating      Int
  comment     String?
  status      CompanyReviewStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  moderatedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([companyId, authorUserId])
  @@map("company_reviews")
}

// ---------- Phase G: training ----------

enum TrainingDomain {
  MARKETING_DIGITAL
  FINANCE
  RH
}

enum TrainingCourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model TrainingCourse {
  id              String                @id @default(cuid())
  slug            String                @unique
  title           String
  domain          TrainingDomain
  description     String
  durationHours   Int?
  status          TrainingCourseStatus  @default(DRAFT)
  createdByUserId String
  createdAt       DateTime              @default(now())

  createdBy User              @relation(fields: [createdByUserId], references: [id])
  sessions  TrainingSession[]

  @@map("training_courses")
}

enum TrainingSessionStatus {
  OPEN
  FULL
  CLOSED
  COMPLETED
  CANCELLED
}

model TrainingSession {
  id             String                 @id @default(cuid())
  courseId       String
  startDate      DateTime
  endDate        DateTime?
  schedule       String?
  price          Int
  currency       String                 @default("MAD")
  instructorName String?
  capacity       Int
  location       String?
  status         TrainingSessionStatus  @default(OPEN)
  createdAt      DateTime               @default(now())

  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@map("training_sessions")
}

enum EnrollmentPaymentMethod {
  VIREMENT
  ESPECES
  AUTRE
}

enum EnrollmentPaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Enrollment {
  id                String                   @id @default(cuid())
  sessionId         String
  userId            String
  candidateId       String?
  paymentMethod     EnrollmentPaymentMethod
  paymentStatus     EnrollmentPaymentStatus  @default(PENDING)
  amount            Int
  currency          String                   @default("MAD")
  enrolledAt        DateTime                 @default(now())
  confirmedAt       DateTime?
  confirmedByUserId String?

  session         TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User            @relation("EnrollmentUser", fields: [userId], references: [id], onDelete: Cascade)
  candidate       Candidate?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  confirmedBy     User?           @relation("EnrollmentConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@unique([sessionId, userId])
  @@map("enrollments")
}

// ---------- Cross-cutting ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/** Saved search (Indeed-style job alert) — new PUBLISHED job postings matching all set criteria notify the owner. */
model JobAlert {
  id        String   @id @default(cuid())
  userId    String
  keyword   String?
  location  String?
  category  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("job_alerts")
}

/** One row per rate-limited attempt (login, registration, password reset...) — see lib/rateLimit.ts. */
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_attempts")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
